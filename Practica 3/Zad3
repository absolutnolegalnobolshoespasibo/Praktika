USD_TO_RUB = 95.50

def convert_usd_to_rub(amount_usd):
    """
    Конвертирует сумму в долларах США в рубли.
    
    Args:
        amount_usd (float): сумма в долларах.
    
    Returns:
        float: эквивалент суммы в рублях.
    """
    return amount_usd * USD_TO_RUB

usd_input = float(input("Введите сумму в долларах: "))
rub_result = convert_usd_to_rub(usd_input)
print(f"{usd_input:.2f} USD = {rub_result:.2f} RUB")

