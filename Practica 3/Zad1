print ("Калькулятор налогов")

TAX_RATE = 0.13

income = float(input("Введите ваш годовой доход: "))

tax = income * TAX_RATE
net_income = income - tax

print(f"Общая сумма дохода: {income:,.2f} руб.")
print(f"Сумма рассчитанного налога: {tax:,.2f} руб.")
print(f"Сумма «на руки» после вычета налога: {net_income:,.2f} руб.")
