print("Опредлеление соответствия цвета клеток шахматной доски")
def Calculate_Colour (Column, Row):
    """
    Определяет цвет клетки шахматной доски по её параметрам

    Параметры:
    Column, Row - координаты шахматной клетки (столбец и строка соответственно)

    Возвращает:
    Цвет клетки в текстовом формате
    """
    if Column % 2 == Row % 2:
        return "White"
    else:
        return "Black"

CHESSBOARD_SIZE = 8
Column1, Row1 = map(int, input("Введите номер столбца и строки первой клетки шахматной доски через пробел (от 1 до 8) ").split())
Column2, Row2 = map(int, input("Введите номер столбца и строки второй клетки шахматной доски через пробел (от 1 до 8) ").split())
if 1 <= Column1 <= CHESSBOARD_SIZE and  1 <= Column2 <= CHESSBOARD_SIZE and 1 <= Row1 <= CHESSBOARD_SIZE and 1 <= Row2 <= CHESSBOARD_SIZE:
    if Calculate_Colour(Column1, Row1) == Calculate_Colour(Column2, Row2):
        print("YES")
    else:
        print("NO")
else:
    print("Ошибка ввода данных")
