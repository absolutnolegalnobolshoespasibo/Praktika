print("Определение возможности слона переместиться на другую клетку")
def Bishop_Movement (Column_Start, Row_Start, Column_End, Row_End):
    """
    Определяет цвет клетки шахматной доски по её параметрам

    Параметры:
    Column_Start, Row_Start - координаты шахматной клетки (столбец и строка соответственно) в которой стоит слон
    Column_End, Row_End - координаты шахматной клетки (столбец и строка соответственно) в которую нужно попасть

    Возвращает:
    True если попасть в клетку возможно
    False если пропасть в клетку невозможно
    """
    # Проверка условия движения слона:
    # Слон ходит только по диагоналям, поэтому разница по горизонтали и вертикали должна быть одинаковой
    if abs(Column_End - Column_Start) == abs(Row_End - Row_Start):
        return True
    else:
        return False

CHESSBOARD_SIZE = 8
Column_StartBishop, Row_StartBishop = map(int, input("Введите номер столбца и строки первой клетки шахматной доски через пробел, в которой стоит слон (от 1 до 8) ").split())
Column_EndBishop, Row_EndBishop = map(int, input("Введите номер столбца и строки второй клетки шахматной доски через пробел, в которую нужно попасть (от 1 до 8) ").split())

# Проверка корректности введенных данных
if 1 <= Column_StartBishop <= CHESSBOARD_SIZE and  1 <= Row_StartBishop <= CHESSBOARD_SIZE and 1 <= Column_EndBishop <= CHESSBOARD_SIZE and 1 <= Row_EndBishop <= CHESSBOARD_SIZE:
    if Bishop_Movement(Column_StartBishop, Row_StartBishop, Column_EndBishop, Row_EndBishop):
        print("YES")
    else:
        print("NO")
else:
    print("Ошибка ввода данных")
