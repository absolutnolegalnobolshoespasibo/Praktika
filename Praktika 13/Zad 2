print("СТАТУС ВАШЕГО ЗАКАЗА")
print("-" * 30)

status = input("Введите статус заказа: ")

match status:
    case "pending":
        print(f"\nСтатус: В ожидании ⏳")
        print(f"Описание: Заказ получен, ожидает обработки")
        print(f"Примерное время: 1-2 часа")
        print(f"Рекомендация: Ожидайте подтверждения заказа")

    case "processing":
        print(f"\nСтатус: В обработке 🔄")
        print(f"Описание: Ваш заказ готовится к отправке")
        print(f"Примерное время: 24-48 часов")
        print(f"Рекомендация: Скоро ваш заказ будет собран")

    case "shipped":
        print(f"\nСтатус: Отправлено ✈️")
        print(f"Описание: Ваш заказ находится в пути к вам")
        print(f"Примерное время: 2-5 дней")
        print(f"Рекомендация: Следите за уведомлениями о доставке")

    case "delivered":
        print(f"\nСтатус: Доставлено ✅")
        print(f"Описание: Заказ успешно доставлен")
        print(f"Примерное время: 0 дней")
        print(f"Рекомендация: Спасибо за покупку!")

    case "cancelled":
        print(f"\nСтатус: Отменено ❌")
        print(f"Описание: Заказ был отменен")
        print(f"Примерное время: —")
        print(f"Рекомендация: Обратитесь в службу поддержки")

    case _:
        print(f"\n❌ Ошибка: Неизвестный статус \"{status}\"")
        print("Доступные статусы: pending, processing, shipped, delivered, cancelled")
