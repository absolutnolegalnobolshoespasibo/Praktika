print("Рейтинг")

rating = input("Введите рейтинг продукта от 1 до 10: ")
match rating:
    case "10" | "9" | "8":
        print("Отличный продукт 👍 Рекомендую")
    case "7" | "6" | "5" | "4" | "3":
        print("Средний продукт ⚖️ Можно попробовать")
    case "2" | "1":
        print("Плохой продукт ❌ Не рекомендую")
    case _:
        print("Ошибка! Рейтинг должен быть от 1 до 10.")
