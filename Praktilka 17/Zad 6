def solve (a,b,c):
    D = b**2 - 4*a*c
    if D < 0:
        return "Ошибка!"
    if D == 0:
        return -b/(2*a)
    else:
        return (-b-D**0.5)/(2*a), (-b+D**0.5)/(2*a)

print(solve(int(input("Введите коэффицент а ")), int(input("Введите коэффицент b ")), int(input("Введите коэффицент с "))))
