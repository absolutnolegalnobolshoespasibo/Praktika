def is_prime(num):
    prime = True
    num = int(num)
    if num > 1:
        for i in range(2, int(num**0.5) + 1):
            if num % i == 0:
                prime = False
                break
    return prime

def is_valid_password(password):
    parts = password.split(':')

    if len(parts) != 3:
        return False

    a, b, c = parts

    if not a.isdigit() or not b.isdigit() or not c.isdigit():
        return False

    if a != a[::-1]:
        return False

    if not is_prime(b):
        return False

    if int(c) % 2 != 0:
        return False

    return True

