print("Все вместе")
Number = int(input("Введите число: "))

count_3 = 0
count_last_digit = 0
count_even = 0
sum_greater_than_5 = 0
composition_greater_than_7 = 1
count_0_and_5 = 0
count_greater_than_7 = 0
last_digit = Number % 10
NumberIsNatural = True

if Number <= 0:
    NumberIsNatural = False

while Number > 0:
    digit = Number % 10
    if digit == 3:
        count_3 += 1
    if digit == last_digit:
        count_last_digit += 1
    if digit % 2 == 0:
        count_even += 1
    if digit > 5:
        sum_greater_than_5 += digit
    if digit > 7:
        composition_greater_than_7 *= digit
        count_greater_than_7 += 1
    if digit == 0 or digit == 5:
        count_0_and_5 += 1
    Number //= 10

if not NumberIsNatural:
    print("Ошибка! Введено не натуральное число")
else:
    print(f"Количество цифр 3: {count_3}")
    print(f"Сколько раз в нём встречается последняя цифра: {count_last_digit}")
    print(f"Количество чётных цифр: {count_even}")
    print(f"Сумма его цифр, больших пяти: {sum_greater_than_5}")
    print(f"Произведение цифр, больших семи: {composition_greater_than_7}")
    print(f"Сколько раз в нём встречаются цифры 0 и 5: {count_0_and_5}")
